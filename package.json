{
  "name": "route-solver-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test 'tests/**/*.test.mjs'",
    "test:legacy": "node --test 'legacy/tests/**/*.test.mjs'",
    "doctor": "node scripts/data-doctor.mjs",
    "perf": "node legacy/scripts/perf-profile.mjs",
    "data:cities": "node scripts/00-cities.mjs",
    "data:graph": "node scripts/01-graph.mjs",
    "data:puzzles": "node scripts/02-puzzles.mjs",
    "data:map": "node scripts/03-map.mjs && node scripts/05-bundle.mjs && python3 scripts/04-terrain.py",
    "data:streets": "node scripts/07-streets.mjs",
    "data:cartography": "node scripts/09-real-osm-forests.mjs",
    "play": "node play/cli.mjs",
    "calibrate": "node play/calibrate.mjs",
    "calibrate:hos": "node play/calibrate-hos.mjs",
    "serve": "node legacy/scripts/serve.mjs",
    "balance": "node play/balance-check.mjs",
    "core-loop:play": "node core-loop/play.mjs",
    "atlas": "node scripts/serve-atlas.mjs",
    "atlas:data": "node atlas/build-geojson.mjs",
    "atlas:check": "node atlas/check-style.mjs",
    "osm:build": "node scripts/16-build-osm-graph.mjs",
    "runs:check": "node --max-old-space-size=14000 scripts/17-check-runs.mjs",
    "runs:geometry": "node --max-old-space-size=14000 scripts/19-run-geometry.mjs",
    "fuel:gate": "node --max-old-space-size=14000 scripts/20-fuel-gate.mjs",
    "fuel:spacing": "node --max-old-space-size=14000 scripts/21-station-spacing.mjs",
    "enforce:exposure": "node --max-old-space-size=14000 scripts/22-enforcement-exposure.mjs",
    "traffic:gate": "node --max-old-space-size=14000 scripts/24-traffic-gate.mjs",
    "order:gate": "node --max-old-space-size=14000 scripts/25-checkpoint-order-gate.mjs"
  },
  "devDependencies": {
    "d3-delaunay": "^6.0.4",
    "mapshaper": "^0.6.102"
  }
}
